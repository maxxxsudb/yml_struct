version: '3'
services:
  opensearch-node1:
    image: opensearchproject/opensearch:latest
    container_name: opensearch-node1
    environment:
      - cluster.name=opensearch-cluster
      - node.name=opensearch-node1
      - discovery.type=single-node
      - bootstrap.memory_lock=true # Отключаем своппинг для производительности
      - "OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m" # Ограничиваем память Java (минимум 512, лучше 1024 или 2048)
      - "OPENSEARCH_INITIAL_ADMIN_PASSWORD=MyStrongAdminPass123!" # Обязательно: сложный пароль
    ulimits:
      memlock:
        soft: -1
        hard: -1
      nofile:
        soft: 65536 # Максимум открытых файлов
        hard: 65536
    volumes:
      - opensearch-data1:/usr/share/opensearch/data
    ports:
      - 9200:9200
      - 9600:9600 # Порт для метрик
    networks:
      - opensearch-net

  opensearch-dashboards:
    image: opensearchproject/opensearch-dashboards:latest
    container_name: opensearch-dashboards
    ports:
      - 5601:5601
    expose:
      - "5601"
    environment:
      - 'OPENSEARCH_HOSTS=["https://opensearch-node1:9200"]'
      # Отключаем проверку сертификата, т.к. OpenSearch сгенерирует самоподписанный
      - "OPENSEARCH_SSL_VERIFICATIONMODE=none" 
    networks:
      - opensearch-net
    depends_on:
      - opensearch-node1

volumes:
  opensearch-data1:

networks:
  opensearch-net:
